# PDF OCR Enhancement Tool - Environment Variables

# Application
DEBUG=false
APP_NAME="PDF OCR Enhancement Tool"

# Server
HOST=0.0.0.0
PORT=8000

# File limits
MAX_FILE_SIZE_MB=100
MAX_PAGES=500

# Processing defaults
DEFAULT_LANGUAGE=spa+eng
DEFAULT_DPI=300

# Cleanup settings
FILE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

# CORS (comma-separated list of allowed origins)
# CORS_ORIGINS=https://your-frontend.netlify.app
